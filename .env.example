# Copy this file to ".env" and fill in ONE key. Never commit ".env".

# Option A: Groq (Llama 3)  -> https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini  -> https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: force a provider ("groq" or "gemini"). Otherwise whichever key is set is used.
# LLM_PROVIDER=groq

# Optional: seconds to wait for the LLM before using the built-in fallback
# LLM_TIMEOUT=15

# Optional: swap the database (SQLite by default)
# DATABASE_URL=sqlite:///./neurohaven.db
